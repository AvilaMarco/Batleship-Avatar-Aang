# SOLO PRUEBAS LOCALES (--env-file con compose.yaml + deploy/compose.local.yaml; ver docs/deploy/PRIMER-DESPLIEGUE.md).
# En el servidor los secretos los genera el servidor (secrets.env, root 600): nunca pongas aqui valores reales.
# Secretos de prueba: openssl rand -hex 32
VERSION=local
POSTGRES_PASSWORD=
JWT_SECRET=
# Puerto de prueba en 127.0.0.1 (rango de desarrollo 4700-4759)
APP_PORT=4756
