# Copiar a .env (NO versionado). Secretos: openssl rand -base64 48 (Git Bash o Linux)
APP_TAG=latest
POSTGRES_DB=shipbender
POSTGRES_USER=shipbender
POSTGRES_PASSWORD=
JWT_SECRET=
JWT_EXPIRATION_MINUTES=480
# Token del tunel (panel de Cloudflare Zero Trust)
TUNNEL_TOKEN=
# Carpeta de backups: otro disco o carpeta sincronizada, FUERA del repo (ruta absoluta del servidor)
BACKUP_DIR=./backups
RETENTION_DAYS=14
