# Copiar a .env (NO versionado). Secretos: openssl rand -base64 48 (Git Bash o Linux)
APP_TAG=latest
POSTGRES_DB=shipbender
POSTGRES_USER=shipbender
POSTGRES_PASSWORD=
JWT_SECRET=
JWT_EXPIRATION_MINUTES=480
# Token del tunel (panel de Cloudflare Zero Trust)
TUNNEL_TOKEN=
# Carpeta de backups: privada, fuera del repo, otro disco; no una carpeta de nube compartida sin cifrar
BACKUP_DIR=/ruta/absoluta/en/OTRO/disco/shipbender-backups
RETENTION_DAYS=14
