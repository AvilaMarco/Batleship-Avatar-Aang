# Copiar a .ship.env (NO versionado). Solo para scripts/ship.sh, en la PC de desarrollo.
SHIP_HOST=servidor.ejemplo
SHIP_USER=deploy
# Clave privada que SOLO sirve para desplegar (ver runbook: authorized_keys con restrict,command=...)
SHIP_KEY=C:/Users/tu-usuario/.ssh/shipbender_deploy
# Rama desde la que se permite desplegar
SHIP_BRANCH=main
